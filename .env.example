# NexoVia API local configuration.
# Copy to .env for local development. Never commit real secrets.

ENVIRONMENT=local
APP_NAME=NexoVia
API_VERSION=v1

# PostgreSQL/Supabase/Neon connection string. Do not expose this to the frontend.
DATABASE_URL=postgresql+psycopg://nexovia_user:nexovia_password@localhost:5432/nexovia
TEST_DATABASE_URL=postgresql+psycopg://nexovia_user:nexovia_password@localhost:5432/nexovia_test

# Generate strong random values for real environments.
JWT_SECRET=replace-with-a-strong-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=

# Comma-separated allowlist. Production must contain only real frontend domains.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public URLs for docs/deploy notes.
FRONTEND_PUBLIC_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000

# Optional email provider credentials for later phases.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
